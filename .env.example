# ========== محلي وإنتاج ==========
# استخدم رابط Neon نفسه محليًا وفي الإنتاج (Prisma provider مضبوط على postgresql)
DATABASE_URL="postgresql://USER:PASS@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

ADMIN_PASSWORD="غيّر-كلمة-مرور-قوية"
ADMIN_SECRET="سلسلة-عشوائية-طويلة-جدا"

# تنبيه بالإيميل عند وصول طلب جديد (اختياري) — مفتاح من https://resend.com
# الإيميل يوصل على NOTIFY_EMAIL (لو فاضي: إيميل الموقع من الإعدادات).
# بدون ربط دومين في Resend، لازم NOTIFY_EMAIL يكون نفس الإيميل اللي سجّلت بيه في Resend.
RESEND_API_KEY=""
NOTIFY_EMAIL=""
# NOTIFY_FROM="Plumber <leads@plumberkuw.com>"  # بعد ربط الدومين في Resend

# تنبيهات تليجرام عند وصول طلب جديد (اختياري)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# رفع صور على Netlify: استخدم Cloudinary (مجاني) — القرص غير دائم
# CLOUDINARY_CLOUD_NAME="your_cloud"
# CLOUDINARY_UPLOAD_PRESET="your_unsigned_preset"

# أو Vercel Blob لو استخدمت Vercel
# BLOB_READ_WRITE_TOKEN=""

# رابط الموقع للـ sitemap والـ SEO (اختياري — على Netlify ياخذ رابط الموقع تلقائيًا)
# NEXT_PUBLIC_SITE_URL="https://plumberkuw.com"
